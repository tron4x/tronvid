{
  "name": "tronvid",
  "version": "1.7.1",
  "description": "A modern, cross-platform video player with playlist support",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --mac --win --linux",
    "build:win32": "electron-builder --win --ia32",
    "build:win64": "electron-builder --win --x64",
    "build:linux64": "electron-builder --linux --x64",
    "build:64": "electron-builder --win --linux --x64",
    "build:win-all": "electron-builder --win --ia32 --x64"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tron4x/tronvid.git"
  },
  "bugs": {
    "url": "https://github.com/tron4x/tronvid/issues"
  },
  "homepage": "https://github.com/tron4x/tronvid#readme",
  "keywords": [
    "video",
    "player",
    "electron",
    "mp4",
    "mov",
    "mkv",
    "cross-platform",
    "playlist",
    "media"
  ],
  "author": {
    "name": "tron4x",
    "email": "tron4x@users.noreply.github.com",
    "url": "https://github.com/tron4x"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "build": {
    "appId": "com.tron4x.tronvid",
    "productName": "TronVid",
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "extendInfo": {
        "CFBundleName": "TronVid",
        "CFBundleDisplayName": "TronVid"
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "defaultArch": "ia32"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Video",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "build/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  }
}
