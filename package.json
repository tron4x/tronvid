{
  "name": "tronvid",
  "version": "1.6.4",
  "description": "A modern, cross-platform video player with playlist support",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --mac --win --linux"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tron4x/tronvid.git"
  },
  "bugs": {
    "url": "https://github.com/tron4x/tronvid/issues"
  },
  "homepage": "https://github.com/tron4x/tronvid#readme",
  "keywords": [
    "video",
    "player",
    "electron",
    "mp4",
    "mov",
    "mkv",
    "cross-platform",
    "playlist",
    "media"
  ],
  "author": {
    "name": "tron4x",
    "url": "https://github.com/tron4x"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "build": {
    "appId": "com.tron4x.tronvid",
    "productName": "TronVid",
    "mac": {
      "category": "public.app-category.video",
      "target": ["dmg", "zip"],
      "icon": "build/icon.icns",
      "extendInfo": {
        "CFBundleName": "TronVid",
        "CFBundleDisplayName": "TronVid"
      }
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Video"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "build/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  }
}
