{
  "manifest_version": 3,
  "name": "TronVid - Add to Playlist",
  "version": "1.0.0",
  "description": "Add YouTube, Vimeo, Twitch, and Dailymotion videos directly to TronVid",
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtu.be/*",
    "*://*.vimeo.com/*",
    "*://*.twitch.tv/*",
    "*://*.dailymotion.com/*",
    "*://dai.ly/*"
  ],
  "action": {
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Add to TronVid"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtu.be/*",
        "*://*.vimeo.com/*",
        "*://*.twitch.tv/*",
        "*://*.dailymotion.com/*",
        "*://dai.ly/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
